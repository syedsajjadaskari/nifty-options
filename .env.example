# Platform Configuration
PLATFORM_ENV=development
LOG_LEVEL=INFO
BROKER_TYPE=5paisa
OPERATIONAL_MODE=paper

# 5paisa API Credentials (replace with your actual credentials in .env)
FIVEPAISA_APP_NAME=your_app_name
FIVEPAISA_APP_SOURCE=your_app_source
FIVEPAISA_USER_ID=your_user_id
FIVEPAISA_PASSWORD=your_password
FIVEPAISA_USER_KEY=your_user_key
FIVEPAISA_ENCRYPTION_KEY=your_encryption_key
FIVEPAISA_CLIENT_CODE=your_client_code
FIVEPAISA_TOTP_SECRET=your_totp_secret_base32
FIVEPAISA_PIN=your_account_pin

# Historical Data Configuration
DATA_START_DATE=2025-09-01
DATA_END_DATE=2026-08-31
DATA_TIMEFRAME=1m
DATA_FORMAT=parquet
DATA_COMPRESSION=zstd
TIMEZONE=Asia/Kolkata

# Execution Safeguards
ENABLE_LIVE_TRADING=false

